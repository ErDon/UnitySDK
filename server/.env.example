# Copy to .env locally. Leave unused platform fields empty. Never commit .env.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_PAYMENT_APP_KEY=
WECHAT_CALLBACK_TOKEN=
WECHAT_CREDENTIAL_KEY_HEX=
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=
DOUYIN_CALLBACK_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# A deployment-generated 32-byte encryption key, encoded as 64 hexadecimal characters.
# Retain the same value across restarts; changing it prevents existing tokens from decrypting.
TIKTOK_CREDENTIAL_KEY_HEX=
# Optional trusted local module exporting async function deliver(message).
SDK_DELIVERY_MODULE=
# Optional ADMIN recovery CLI only. Keep separate from platform and encryption keys.
SDK_OPERATOR_KEY_ID=operator-v1
SDK_OPERATOR_KEY_HEX=
